# Copy this file to .env and fill in real values.
# Expo automatically inlines any EXPO_PUBLIC_* variable into the JS bundle at
# build time (see https://docs.expo.dev/guides/environment-variables/), so
# these are only for values that are already meant to be public client-side
# (reCAPTCHA site keys are public by design; never put a reCAPTCHA *secret*
# key or anything else truly sensitive here — that belongs on the backend).

# Static page (hosted on climbing.ge, NOT in this repo) that utils/recaptcha.js
# navigates a hidden WebView to, so reCAPTCHA v3 gets a real, domain-validated
# origin instead of the weaker source={{html, baseUrl}} trick. The page itself
# is generic — reads ?sitekey=&action= from its own query string — so this
# only needs to change if its hosted path ever moves.
EXPO_PUBLIC_RECAPTCHA_HOST_URL=https://climbing.ge/recaptcha-mobile.html

# reCAPTCHA v3 site key registered specifically for this mobile app (a
# SEPARATE key from the web frontend's, registered against the host page
# above's domain in Google's reCAPTCHA console). Leave blank until that
# registration exists — a placeholder-looking key here would silently fail
# verification with no indication it's a config problem.
#
# The matching secret does NOT go here — it belongs exclusively in the
# backend repo's (climbing.ge) own .env, as GOOGLE_CAPTCHA_V3_MOBILE_SECRET_KEY.
# The backend's ReCaptchaV3Service::verifySmart() already tries the web secret
# first, then this mobile secret (at a lower threshold) — decided by which one
# the token actually validates against, not by anything this app declares.
# These two vars are two different repos' env files; do not conflate them.
# No backend code changes are needed for this — verifySmart() already exists.
EXPO_PUBLIC_RECAPTCHA_V3_MOBILE_SITE_KEY=

# Fallback bank transfer details shown in the donation modal's Bank Transfer
# tab if the live GET /api/get_donation/tbc_info call fails. Leave blank to
# just show an error instead of a fallback (current default behavior).
EXPO_PUBLIC_DONATION_BANK_NAME=TBC Bank
EXPO_PUBLIC_DONATION_BANK_CODE=TBCBGE22
EXPO_PUBLIC_DONATION_ACCOUNT_NAME=
EXPO_PUBLIC_DONATION_IBAN=
