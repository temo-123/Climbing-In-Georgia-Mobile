{
  "expo": {
    "name": "Climb Georgia",
    "slug": "climbing-in-georgia-mobile",
    "version": "1.2.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.climbing.app",
      "buildNumber": "17",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to view and attach climbing route photos.",
        "NSPhotoLibraryAddUsageDescription": "Used to save climbing route photos.",
        "NSCameraUsageDescription": "Used to take a photo of your ascent.",
        "CFBundleLocalizations": [
          "en"
        ],
        "CFBundleDevelopmentRegion": "en",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ge.climbing.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 17,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Used to take a photo of your ascent.",
          "microphonePermission": false,
          "photosPermission": "Used to attach a photo to your ascent."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#279fbb",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9d7c01bc-2fbf-4bdd-aa63-fd7af5536760"
      }
    },
    "owner": "temo-123"
  }
}
